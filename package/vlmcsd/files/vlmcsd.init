#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10
start_service() {
 local enabled iface
 config_load vlmcsd
 config_get_bool enabled main enabled 0
 config_get iface main interface lan
 [ "$enabled" = 1 ] || return 0
 /usr/libexec/vlmcsd-helper render || return 1
 /usr/libexec/vlmcsd-helper dns || return 1
 procd_open_instance main
 procd_set_param command /usr/sbin/vlmcsd -D -i /var/etc/vlmcsd.ini
 procd_set_param user vlmcsd
 procd_set_param group vlmcsd
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param respawn 60 5 3
 procd_set_param term_timeout 5
 procd_set_param file /etc/config/vlmcsd /var/etc/vlmcsd.ini
 procd_close_instance
}
stop_service() {
 # Remove a previously published record even if the LAN is currently down.
 if [ "$(uci -q get dhcp.vlmcsd_srv.vlmcsd_owned)" = 1 ]; then
  uci -q delete dhcp.vlmcsd_srv
  uci commit dhcp
  /etc/init.d/dnsmasq reload
 fi
 return 0
}
reload_service() {
 /usr/libexec/vlmcsd-helper validate || return 1
 stop
 start
}
service_triggers() {
 local iface
 config_load vlmcsd
 config_get iface main interface lan
 procd_add_reload_trigger vlmcsd
 procd_add_interface_trigger 'interface.*' "$iface" /etc/init.d/vlmcsd reload
}
